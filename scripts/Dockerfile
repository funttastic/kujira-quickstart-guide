FROM ubuntu:latest

ENV DEBIAN_FRONTEND="noninteractive"
ENV TZ="Etc/GMT"

ENV ADMIN_USERNAME="$ADMIN_USERNAME"
ENV ADMIN_PASSWORD="$ADMIN_PASSWORD"
ENV ADMIN_EMAIL="$ADMIN_EMAIL"

ENV DOMAIN="$DOMAIN"
ENV AUTO_SIGN_IN="$AUTO_SIGN_IN"
ENV LOCK_APT="$LOCK_APT"

ENV FUN_FRONTEND_REPOSITORY_URL="$FUN_FRONTEND_REPOSITORY_URL"
ENV FUN_FRONTEND_REPOSITORY_BRANCH="$FUN_FRONTEND_REPOSITORY_BRANCH"
ENV FUN_FRONTEND_COMMAND="$FUN_FRONTEND_COMMAND"
ENV FUN_FRONTEND_PORT="$FUN_FRONTEND_PORT"

ENV FUN_API_REPOSITORY_URL="$FUN_API_REPOSITORY_URL"
ENV FUN_API_REPOSITORY_BRANCH="$FUN_API_REPOSITORY_BRANCH"
ENV FUN_API_COMMAND="$FUN_API_COMMAND"
ENV FUN_API_PORT="$FUN_API_PORT"

ENV HB_GATEWAY_REPOSITORY_URL="$HB_GATEWAY_REPOSITORY_URL"
ENV HB_GATEWAY_REPOSITORY_BRANCH="$HB_GATEWAY_REPOSITORY_BRANCH"
ENV HB_GATEWAY_COMMAND="$HB_GATEWAY_COMMAND"
ENV HB_GATEWAY_PORT="$HB_GATEWAY_PORT"

ENV HB_CLIENT_REPOSITORY_URL="$HB_CLIENT_REPOSITORY_URL"
ENV HB_CLIENT_REPOSITORY_BRANCH="$HB_CLIENT_REPOSITORY_BRANCH"
ENV HB_CLIENT_COMMAND="$HB_CLIENT_COMMAND"

ENV FILEBROWSER_COMMAND="$FILEBROWSER_COMMAND"
ENV FILEBROWSER_PORT="$FILEBROWSER_PORT"

WORKDIR /root

RUN :> /root/.bashrc

RUN rm /usr/bin/sh && ln -s /bin/bash /usr/bin/sh

RUN <<-EOF
	set -ex

  curl -o /tmp/standalone_install.sh https://raw.githubusercontent.com/funttastic/kujira-quickstart-guide/production/scripts/standalone_install.sh

  chmod +x /tmp/standalone_install.sh

  source /tmp/standalone_install.sh

  fun_standalone_install --username=$ADMIN_USERNAME --password=$ADMIN_PASSWORD --email=$ADMIN_EMAIL --domain=$DOMAIN --auto-sign-in=$AUTO_SIGN_IN --lock-apt=$LOCK_APT

  export IS_FIRST_RUN=TRUE

  echo "\n\n\n"
  env
  echo "\n\n\n"

	set +ex
EOF

EXPOSE $FUN_FRONTEND_PORT
EXPOSE $FILEBROWSER_PORT

#ENTRYPOINT ["/root/shared/scripts/functions.sh"]
#CMD ["start_and_keep"]

CMD ["tail -f /dev/null"]
